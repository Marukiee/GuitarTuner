<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Only ever used to ask the GitHub Releases API whether a newer APK exists.
         No audio, and nothing else, ever leaves the device. Without this the update
         check throws a SecurityException that the checker swallows, so the banner
         silently never appears. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- So an update can be handed to the system installer from inside the app. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- With the above, Android 12 and later replace the app without asking again, once an
         earlier update has been installed through the app itself. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <!-- enableOnBackInvokedCallback is what lets the platform send in-flight back progress
         instead of a single back press. targetSdk 36 turns it on by default, so it is written
         down for the day the target moves rather than for today: without it
         PredictiveBackHandler collapses to a plain back press and the Settings page jumps
         shut instead of following the thumb. -->
    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GuitarTuner">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.GuitarTuner"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Where the system installer reports on an update that was handed to it. Not exported:
             the system fills in the PendingIntent that points here. -->
        <receiver
            android:name=".update.InstallStatusReceiver"
            android:exported="false" />

        <!-- Keeps the per-app language across restarts on Android 12 and older. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
