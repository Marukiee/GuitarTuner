<?xml version="1.0" encoding="utf-8"?>
<!--
  A tuning fork, drawn to sit in the same family as the MarkMySteps compass and the
  Local AI capsule: one geometric mark, centred, on the shared slate square.

  Everything is expressed as a stroke rather than a filled body. The compass is a thin
  ring and the capsule is a short bar, so both spread their ink along an outline; a
  solid fork would pack the same area into a blob and read heavier next to them even at
  a matching width. 7.5 units of stroke on this 108 canvas puts the total ink at roughly
  900 square units against the compass's 960.

  Coordinates are final viewport units so the centring can be checked by reading them.
  Half strokes and round caps included, the visible bounds run 39.25..68.75 across and
  24.25..83.75 down, both centred on 54 and inside the 66 unit safe circle.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Both tines and the U that joins them, in one stroke. -->
    <path
        android:pathData="M43,28 L43,54 A11,11 0 0 0 65,54 L65,28"
        android:strokeColor="@color/ic_launcher_mark"
        android:strokeWidth="7.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- The stem. It starts inside the U so the two shapes read as one piece of metal. -->
    <path
        android:pathData="M54,63 L54,80"
        android:strokeColor="@color/ic_launcher_mark"
        android:strokeWidth="7.5"
        android:strokeLineCap="round" />
</vector>
