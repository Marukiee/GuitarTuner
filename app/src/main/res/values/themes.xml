<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all real styling; this only kills the platform ActionBar and gives us
         a transparent system-bar surface for enableEdgeToEdge(). AppCompat underneath, so the
         per-app language can recreate the activity in the new language. -->
    <style name="Theme.GuitarTuner" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
